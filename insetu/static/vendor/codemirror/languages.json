{
  "schema": 1,
  "languages": {
    "python": {
      "label": "Python",
      "kind": "builtin",
      "export": "python",
      "extensions": [
        "py",
        "pyi"
      ],
      "sample": "def greet(name: str) -> str:\n    return name\n"
    },
    "javascript": {
      "label": "JavaScript",
      "kind": "builtin",
      "export": "javascript",
      "options": {
        "jsx": true
      },
      "extensions": [
        "js",
        "mjs",
        "cjs",
        "jsx"
      ],
      "sample": "export const add = (a, b) => a + b;\n"
    },
    "typescript": {
      "label": "TypeScript",
      "kind": "builtin",
      "export": "javascript",
      "options": {
        "typescript": true,
        "jsx": true
      },
      "extensions": [
        "ts",
        "mts",
        "cts",
        "tsx"
      ],
      "sample": "export function id<T>(x: T): T { return x; }\n"
    },
    "json": {
      "label": "JSON",
      "kind": "builtin",
      "export": "json",
      "extensions": [
        "json",
        "jsonl"
      ],
      "sample": "{\"ok\": true, \"count\": 1}\n"
    },
    "yaml": {
      "label": "YAML",
      "kind": "builtin",
      "export": "yaml",
      "extensions": [
        "yaml",
        "yml"
      ],
      "sample": "title: Example\ncount: 1\n"
    },
    "html": {
      "label": "HTML",
      "kind": "builtin",
      "export": "htmlLang",
      "extensions": [
        "html",
        "htm"
      ],
      "sample": "<!doctype html><html><body><h1>Hi</h1></body></html>\n"
    },
