{
    "pair": "three_way_merge",
    "status": "covered",
    "why": "The offline outbox merges without the server; the server merges on save.",
    "python": "akasa.merge:three_way_merge_text",
    "javascript": "/static/vendor/sutram/js/merge.js:threeWayMergeText",
    "adapter": "merge",
    "note": "Python takes (base, disk, incoming) and returns (clean, merged). JavaScript takes (base, local, remote) and returns {merged, clean}; local is the incoming side. The adapter maps both to {clean, merged}. One algorithm since 2026-11-10 (issue #18): akasa/merge.py and sutram/js/merge.js are the same steps line for line, and the differential checks they agree on 3,000 small and 2,000 harder seeded inputs. Change one side only with the other.",
    "differential": {
        "seed": 7,
        "count": 3000,
        "wide_seed": 11,
        "wide_count": 2000
    },
    "cases": [
        {
            "label": "one side changed",
            "args": [
                "a\nb\nc",
                "A\nb\nc",
                "a\nb\nc"
            ],
            "expect": {
                "clean": true,
                "merged": "A\nb\nc"
            }
        },
        {
            "label": "other side changed",
            "args": [
                "a\nb\nc",
                "a\nb\nc",
                "a\nb\nC"
            ],
            "expect": {
                "clean": true,
                "merged": "a\nb\nC"
            }
        },
        {
            "label": "both changed different lines",
            "args": [
                "a\nb\nc",
                "A\nb\nc",
                "a\nb\nC"
            ],
            "expect": {
                "clean": true,
                "merged": "A\nb\nC"
            }
        },
        {
            "label": "both made the same change",
            "args": [
                "a\nb\nc",
                "a\nB\nc",
                "a\nB\nc"
            ],
            "expect": {
                "clean": true,
                "merged": "a\nB\nc"
            }
        },
        {
            "label": "both changed the same line differently",
            "args": [
                "a\nb\nc",
                "a\nX\nc",
                "a\nY\nc"
            ],
            "expect": {
                "clean": false
            }
        },
        {
            "label": "Windows line endings on one side",
            "args": [
                "a\nb\nc",
                "a\r\nb\r\nc",
                "a\nb\nC"
            ],
            "expect": {
                "clean": true,
                "merged": "a\nb\nC"
            }
        },
        {
            "label": "incoming deletes a line next to a line disk changed",
            "args": [
                "d\nc\nf\nf\nb\nb",
                "d\nf\nf\nb*\nb",
                "d\nc\nf\nf\nb"
            ],
            "expect": {
                "clean": true,
                "merged": "d\nf\nf\nb*"
            }
        },
        {
            "label": "disk is an earlier save of incoming's new lines (late acknowledgement)",
            "args": [
                "a\nb",
                "a\nx\nb",
                "a\nx\ny\nb"
            ],
            "expect": {
                "clean": true,
                "merged": "a\nx\ny\nb"
            }
        },
        {
            "label": "two different insertions at the same place",
            "args": [
                "a\nb",
                "a\nx\nb",
                "a\ny\nb"
            ],
            "expect": {
                "clean": false,
                "merged": "a\ny\nb"
            }
        },
        {
            "label": "an insertion next to a changed line",
            "args": [
                "a\nb\nc",
                "a\nB\nc",
                "a\nb\nn\nc"
            ],
            "expect": {
                "clean": true,
                "merged": "a\nB\nn\nc"
            }
        },
        {
            "label": "neighbouring lines changed",
            "args": [
                "a\nb\nc\nd",
                "a\nB\nc\nd",
                "a\nb\nC\nd"
            ],
            "expect": {
                "clean": true,
                "merged": "a\nB\nC\nd"
            }
        },
        {
            "label": "one side deletes a line the other changed",
            "args": [
                "a\nb\nc",
                "a\nc",
                "a\nB\nc"
            ],
            "expect": {
                "clean": false,
                "merged": "a\nB\nc"
            }
        },
        {
            "label": "disk uses Windows line endings and both changed",
            "args": [
                "a\r\nb\r\nc\r\nd",
                "A\r\nb\r\nc\r\nd",
                "a\r\nb\r\nc\r\nD"
            ],
            "expect": {
                "clean": true,
                "merged": "A\r\nb\r\nc\r\nD"
            }
        },
        {
            "label": "a trailing newline is kept",
            "args": [
                "a\nb\n",
                "A\nb\n",
                "a\nb\nc\n"
            ],
            "expect": {
                "clean": true,
                "merged": "A\nb\nc\n"
            }
        },
        {
            "label": "a deleted repeated line is merged with a change to its twin, not dropped",
            "args": [
                "c\nc",
                "c",
                "c*\nc"
            ],
            "expect": {
                "clean": true,
                "merged": "c*"
            }
        }
    ]
}
